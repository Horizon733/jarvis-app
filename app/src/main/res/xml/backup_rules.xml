<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The whole app is an "on-device" AI assistant. Nothing user-personal should leave the
         device via Auto Backup: chat history, credentials, downloaded model files, or the
         DataStore-backed preferences. -->
    <exclude domain="sharedpref" path="secure_credentials.xml"/>
    <exclude domain="sharedpref" path="secure_credentials.xml.bak"/>
    <exclude domain="file" path="datastore/settings.preferences_pb"/>
    <exclude domain="file" path="models/"/>
    <exclude domain="file" path="voice/"/>
    <exclude domain="database" path="ai_agent_db"/>
    <exclude domain="database" path="ai_agent_db-shm"/>
    <exclude domain="database" path="ai_agent_db-wal"/>
</full-backup-content>

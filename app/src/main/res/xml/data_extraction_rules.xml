<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_credentials.xml"/>
        <exclude domain="sharedpref" path="secure_credentials.xml.bak"/>
        <exclude domain="file" path="datastore/settings.preferences_pb"/>
        <exclude domain="file" path="models/"/>
        <exclude domain="file" path="voice/"/>
        <exclude domain="database" path="ai_agent_db"/>
        <exclude domain="database" path="ai_agent_db-shm"/>
        <exclude domain="database" path="ai_agent_db-wal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_credentials.xml"/>
        <exclude domain="sharedpref" path="secure_credentials.xml.bak"/>
        <exclude domain="file" path="datastore/settings.preferences_pb"/>
        <exclude domain="file" path="models/"/>
        <exclude domain="file" path="voice/"/>
        <exclude domain="database" path="ai_agent_db"/>
        <exclude domain="database" path="ai_agent_db-shm"/>
        <exclude domain="database" path="ai_agent_db-wal"/>
    </device-transfer>
</data-extraction-rules>
